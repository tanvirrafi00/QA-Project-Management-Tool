# Server Configuration
# Default 5001 to match the frontend (frontend/.env.local → NEXT_PUBLIC_API_URL=http://localhost:5001).
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.5-turbo

# Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ── PostgreSQL Database Configuration ─────────────────────────────────────────
# Primary connection configuration via DATABASE_URL (recommended)
# Format: postgres://user:password@host:port/database?options
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qa_copilot

# Alternative discrete connection parameters (used only if DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qa_copilot
DB_USER=postgres
DB_PASSWORD=postgres

# SSL Configuration
# Set to 'require' for production, 'prefer' for development with SSL support, 'disable' for local dev
DB_SSL_MODE=disable
# Path to SSL certificates (required when SSL is enabled)
# DB_SSL_CA_PATH=/path/to/ca-certificate.crt
# DB_SSL_CERT_PATH=/path/to/client-certificate.crt
# DB_SSL_KEY_PATH=/path/to/client-key.key

# Connection Pool Configuration - Basic Settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# Connection Pool Configuration - Timeout Settings
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_CONNECTION_TIMEOUT=5000
DB_POOL_STATEMENT_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_CREATE_TIMEOUT=30000
DB_POOL_DESTROY_TIMEOUT=5000
DB_POOL_REAP_INTERVAL=1000

# Connection Pool Configuration - Health & Validation
DB_POOL_VALIDATE_ON_BORROW=true
DB_POOL_TEST_ON_CREATE=true
DB_POOL_MAX_WAITING_CLIENTS=0

# Connection Pool Configuration - Performance & Lifecycle
DB_POOL_ALLOW_EXIT_ON_IDLE=false
DB_POOL_MAX_USES=7500
DB_POOL_MAX_LIFETIME_SECONDS=1800

# Connection Pool Configuration - Application Settings
DB_APPLICATION_NAME=qa_copilot_dev
DB_POOL_KEEP_ALIVE=true
DB_POOL_KEEP_ALIVE_INITIAL_DELAY=0

# Environment-specific Database Configuration
# Override database name for different environments
DB_NAME_TEST=qa_copilot_test
DB_NAME_DEVELOPMENT=qa_copilot_dev  
DB_NAME_PRODUCTION=qa_copilot_prod

# Database Migration Configuration
DB_MIGRATION_TABLE=drizzle_migrations
DB_MIGRATION_SCHEMA=public

# Connection Health & Retry Configuration
DB_HEALTH_CHECK_INTERVAL=30000
DB_CONNECTION_RETRY_ATTEMPTS=3
DB_CONNECTION_RETRY_DELAY=1000
DB_CONNECTION_RETRY_BACKOFF=exponential

# ── Auth / RBAC (Migration Roadmap Step 2 — wired in Step 6) ───────────────────
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_also_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Feature flags (Migration Roadmap Step 6 cutover) ──────────────────────────
# All default OFF — the app runs on the in-memory repositories with no auth (current behavior).
# Flip individually to migrate to PostgreSQL / enable auth. See
# docs/postgresql-migration/step6-cutover-runbook.md for the full procedure (requires Postgres +
# `npm run db:migrate` + `npm run db:seed` before flipping the USE_DB_* flags).
AUTH_ENABLED=false
USE_DB_PROJECTS=false
USE_DB_BUGS=false
USE_DB_TEST_CASES=false
